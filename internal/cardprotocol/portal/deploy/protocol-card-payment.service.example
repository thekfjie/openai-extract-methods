[Unit]
Description=Protocol Card Payment Service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/protocol-card-payment
EnvironmentFile=/opt/protocol-card-payment/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/protocol-card-payment/venv/bin/gunicorn --workers 1 --threads 12 --bind 127.0.0.1:18105 --timeout 180 --graceful-timeout 120 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
